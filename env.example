# ─── TaskFlow Board — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Turso (libSQL) ─────────────────────────────────────────────────────────────
# Get these from https://turso.tech → your database → "Connect" tab
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── JWT / Session ──────────────────────────────────────────────────────────────
# Any long random string (min 32 chars). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# ── Vercel (set these in the Vercel dashboard, not here) ──────────────────────
# TURSO_DATABASE_URL → same as above
# TURSO_AUTH_TOKEN   → same as above
# JWT_SECRET         → same as above
